# Names and placeholders only: never a real value. Copy to .env for local runs.
HEALTH_PORT=8080
# The worker's own token (sub: barber-saas-worker): WORKER_SERVICE_TOKEN of barber-saas-infra-postgres/env/dev.env.
SERVICE_TOKEN=
# Producers whose outbox is relayed (ADR-016): appointment, loyalty, identity-auth.
PRODUCERS=appointment
APPOINTMENT_API_URL=http://localhost:8083
LOYALTY_API_URL=
IDENTITY_AUTH_API_URL=
NOTIFICATIONS_API_URL=
PLATFORM_ADMIN_API_URL=
# Daily jobs in local time (Colombia: UTC-5, no daylight saving).
UTC_OFFSET_HOURS=-5
REMINDERS_AT=18:00
NO_SHOWS_AT=01:00
TRIALS_AT=02:00
